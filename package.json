{
  "name": "landvista-ai-monorepo",
  "version": "1.0.0",
  "description": "LANDVISTA AI - Smart Land Utilisation & Decision Platform (SIH)",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm --prefix frontend run build",
    "dev": "npm --prefix frontend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "npm --prefix backend run dev",
    "start:backend": "npm --prefix backend start",
    "build:frontend": "npm --prefix frontend run build",
    "seed:backend": "npm --prefix backend run seed",
    "install:all": "npm --prefix frontend install && npm --prefix backend install"
  },
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.5.2",
    "socket.io": "^4.8.3"
  }
}
